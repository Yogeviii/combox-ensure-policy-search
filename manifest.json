{
  "manifest_version": 3,
  "name": "Commbox to eNsure Policy Search",
  "version": "1.2.4",
  "description": "Searches an eNsure policy and opens a new case tab for the matched customer from Commbox.",
  "permissions": [
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://davidshield.commbox.io/*",
    "https://ds-ensure01.passportcard.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://davidshield.commbox.io/*"
      ],
      "js": [
        "combox-content.js"
      ],
      "css": [
        "combox-content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
