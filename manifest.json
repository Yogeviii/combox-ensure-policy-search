{
  "manifest_version": 3,
  "name": "Commbox to eNsure Policy Search",
  "version": "1.3.0",
  "description": "Searches eNsure policies and claims, and opens a new case tab for the matched customer from Commbox.",
  "permissions": [
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://davidshield.commbox.io/*",
    "https://ds-ensure01.passportcard.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://davidshield.commbox.io/*"
      ],
      "js": [
        "combox-content.js",
        "claims-feature/combox-claims-button.js"
      ],
      "css": [
        "combox-content.css",
        "claims-feature/combox-claims-button.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
